# Copy this file to .env and fill in the credentials
EMAIL_USER=info@ledgifysolutions.com
# Titan Mail (Hostinger) mailbox password, not a Gmail app password
EMAIL_PASS=your_mailbox_password_here
# Titan SMTP defaults — override only if Hostinger support says otherwise
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
# optional override for API base if you deploy backend separately
API_BASE=/api
PORT=5000
# The public URL where the site will be hosted (e.g. https://www.ledgifysolutions.com)
# Used to generate absolute open-graph URLs in the HTML.  This value is
# exposed to the browser as `import.meta.env.VITE_SITE_URL` so it must be
# prefixed with VITE_. No trailing slash - callers append leading-slash paths.
VITE_SITE_URL=https://www.ledgifysolutions.com

# Optional override for the API base path. Defaults to /api in the client.
VITE_API_BASE=/api
