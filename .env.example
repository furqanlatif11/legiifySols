# Copy this file to .env and fill in the credentials
EMAIL_USER=ledgifysolutionsllc@gmail.com
# For Gmail you'll likely need to create an App Password and put it here
EMAIL_PASS=your_app_password_here
# optional override for API base if you deploy backend separately
API_BASE=/api
PORT=5000
# The public URL where the site will be hosted (e.g. https://legiify-sols.vercel.app)
# Used to generate absolute open-graph URLs in the HTML.  This value is
# exposed to the browser as `import.meta.env.VITE_SITE_URL` so it must be
# prefixed with VITE_.
VITE_SITE_URL=https://legiify-sols.vercel.app

# Optional override for the API base path. Defaults to /api in the client.
VITE_API_BASE=/api
